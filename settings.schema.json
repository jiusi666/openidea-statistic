{
  "properties": {
    "excludeDirs": {
      "type": "string",
      "title": "排除的目录（逗号分隔，匹配路径中的目录段）",
      "default": ".git,.idea,.vscode,node_modules,target,dist,build,out,bin,obj,vendor,.venv,venv,__pycache__,coverage,.gradle,.next,.nuxt,.cache"
    },
    "maxFileBytes": {
      "type": "number",
      "title": "单文件最大字节数，超过则跳过行数统计",
      "default": 2097152,
      "minimum": 1024,
      "maximum": 16777216
    },
    "includeHidden": {
      "type": "boolean",
      "title": "包含隐藏文件与目录",
      "default": false
    },
    "showStatusBar": {
      "type": "boolean",
      "title": "在状态栏显示总行数",
      "default": true
    },
    "decorateTree": {
      "type": "boolean",
      "title": "在项目树标记高风险文件（感叹号徽标，悬停看详情）",
      "default": true
    },
    "warnFileLines": {
      "type": "number",
      "title": "超长文件阈值（代码行）",
      "default": 800,
      "minimum": 50,
      "maximum": 200000
    },
    "warnFunctionLines": {
      "type": "number",
      "title": "超长函数阈值（行）",
      "default": 60,
      "minimum": 5,
      "maximum": 5000
    },
    "warnComplexity": {
      "type": "number",
      "title": "高复杂度阈值（单文件圈复杂度）",
      "default": 15,
      "minimum": 1,
      "maximum": 500
    }
  }
}
